# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/fairness_audit
# Alternative: DuckDB file path
DUCKDB_PATH=data/fairness_audit.db

# API Configuration
FBI_API_DELAY=1.0
CITY_DATA_API_KEY=your_api_key_here

# Analysis Parameters
MIN_SAMPLE_SIZE=100
CONFIDENCE_LEVEL=0.95

# Logging
LOG_LEVEL=INFO

# Streamlit (set automatically in Dockerfile, but can override here)
# STREAMLIT_SERVER_PORT=8501
